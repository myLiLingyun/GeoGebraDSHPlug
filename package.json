{
  "name": "dsh-geogebra-bridge-bundle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH bundle：声明「数学模式」与「数学模式+」两个 agent preset，在 preset 自己的 scope 里接入 GeoGebra 桥（MCP stdio server），并在 DSH 网页界面提供「打开画布」确认弹窗与代理路由。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "routes.js",
    "LICENSE",
    "LICENSE.CC-BY-NC-SA-4.0",
    "README.md"
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myLiLingyun/GeoGebraDSHPlug.git"
  },
  "homepage": "https://github.com/myLiLingyun/GeoGebraDSHPlug#readme",
  "bugs": {
    "url": "https://github.com/myLiLingyun/GeoGebraDSHPlug/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "geogebra",
    "math"
  ],
  "meta": {
    "title": "GeoGebra 桥 + 数学模式 / 数学模式+",
    "description": "「数学模式」里接入 geogebra-mcp-bridge（MCP stdio 程序）：mcp__geogebra__* 只对该模式可见；建画布时在网页界面弹窗，等用户确认已打开再继续。「数学模式+」在此之上并入标准模式的全部工具，系统提示词是两边 persona 提示词的拼接。"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
